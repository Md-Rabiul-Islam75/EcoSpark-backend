{
	"redirects": [
		{
			"source": "/",
			"destination": "/health",
			"permanent": false
		}
	],
	"rewrites": [
		{
			"source": "/health",
			"destination": "/api/health"
		},
		{
			"source": "/api/v1/ideas/:ideaId/comments",
			"destination": "/api/idea-comments?ideaId=:ideaId"
		},
		{
			"source": "/api/v1/ideas/:ideaId/votes",
			"destination": "/api/idea-votes?ideaId=:ideaId"
		},
		{
			"source": "/api/v1/ideas/:slug",
			"destination": "/api/idea-detail?slug=:slug"
		},
		{
			"source": "/api/v1/payments/checkout",
			"destination": "/api/payment-checkout"
		},
		{
			"source": "/api/v1/:path*",
			"destination": "/api/:path*"
		}
	]
}